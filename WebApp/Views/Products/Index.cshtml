@model IReadOnlyList<WebApp.Models.ProductViewModel>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Products</h1>
        <p class="text-muted mb-0">Manage products from the Product API.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add product</a>
</div>

@if (ViewBag.ApiError is string apiError)
{
    <div class="alert alert-danger" role="alert">@apiError</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name" aria-label="Search by name" />
    </div>
    <div class="col-auto">
        <select name="type" class="form-select" aria-label="Filter by type">
            <option value="">All types</option>
            @foreach (var pt in Enum.GetValues<WebApp.Models.ProductType>())
            {
                var selected = string.Equals(ViewBag.Type as string, pt.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null;
                <option value="@pt" selected="@selected">@pt</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Count == 0 && ViewBag.ApiError is null)
{
    <div class="alert alert-info" role="status">No products found. Add a product to get started.</div>
}
else if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="text-end">Price</th>
                    <th scope="col">Stock</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Description</td>
                        <td>@Html.DisplayFor(_ => product.ProductType)</td>
                        <td class="text-end">@product.Price.ToString("N0")</td>
                        <td>@await Html.PartialAsync("_StockBadge", product.Stock)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
